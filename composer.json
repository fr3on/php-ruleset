{
    "name": "fr3on/php-ruleset",
    "description": "Standalone business rule and expression evaluator for PHP 8.4+",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Ahmed Mardi",
            "role": "Developer"
        }
    ],
    "keywords": ["rules", "expression-evaluator", "business-rules", "parser", "lexer", "php84"],
    "require": {
        "php": ">=8.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "phpstan/phpstan": "^2.1",
        "friendsofphp/php-cs-fixer": "^3.68"
    },
    "autoload": {
        "psr-4": {
            "Fr3on\\Ruleset\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Fr3on\\Ruleset\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
